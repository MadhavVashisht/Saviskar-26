# ==============================================================================
# SAVISKAR 2026 — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local (or .env.development.local) and fill in your values.
# ==============================================================================

# Site URL
# Local: http://localhost:3000
# Production: https://saviskar.co.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# Dashboard: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ------------------------------------------------------------------------------
# Resend Email Service
# Dashboard: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Saviskar 2026 <noreply@yourdomain.com>"

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway
# Dashboard: https://dashboard.razorpay.com/app/keys
# Test keys start with "rzp_test_", Live keys start with "rzp_live_"
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Razorpay Webhook Secret (Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PAYMENT_GATEWAY=razorpay

# ------------------------------------------------------------------------------
# Admin & Security Overrides (Optional / Production Required)
# ------------------------------------------------------------------------------
PRIMARY_ADMIN_EMAIL=admin@yourdomain.com
# PRIMARY_ADMIN_USER_ID=
# PAYMENT_RESUME_TOKEN_SECRET=

# Registration Authentication Session Secret (High entropy server-only secret, e.g. openssl rand -hex 32)
# Required in production; application authentication will fail closed if missing.
# NEVER expose to client bundles or NEXT_PUBLIC_* variables.
SESSION_SECRET=your_32_byte_session_secret

# ------------------------------------------------------------------------------
# External Google Drive Gallery Links
# Paste public Google Drive folder URLs or direct file sharing links:
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAIN_GALLERY_GDRIVE_URL=""
NEXT_PUBLIC_GLIMPSE_GALLERY_GDRIVE_URL=""
